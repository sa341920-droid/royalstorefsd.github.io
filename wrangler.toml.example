name = "royal-mobile-store"
main = "worker.js"
compatibility_date = "2026-10-26"

# Create a KV namespace and replace the placeholder id below.
[[kv_namespaces]]
binding = "STORE"
id = "REPLACE_WITH_YOUR_KV_NAMESPACE_ID"

# Configure ADMIN_PASSWORD using Cloudflare dashboard secret settings, not plain text here.
# Optional Workers AI binding must be configured in the Cloudflare dashboard.
