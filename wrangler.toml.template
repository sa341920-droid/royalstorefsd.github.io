# Royal Mobile & Printing Store — Cloudflare Worker configuration
# Rename this file to wrangler.toml after replacing YOUR_KV_NAMESPACE_ID.
name = "royal-mobile-store-api"
main = "worker.js"
compatibility_date = "2026-10-27"

[[kv_namespaces]]
binding = "STORE"
id = "YOUR_KV_NAMESPACE_ID"

# Optional: bind Workers AI in Cloudflare Dashboard:
# Settings → Bindings → Add → Workers AI
# Variable name: AI
